# ============================================================================
# TAXFLOW AI – ULTIMATE EDITION v9.0.0
# ============================================================================

ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---------- API ----------
API_V1_STR=/api/v1
PROJECT_NAME=TaxFlow AI
VERSION=9.0.0
BACKEND_CORS_ORIGINS=["https://app.taxflow.ai","https://admin.taxflow.ai"]
TRUSTED_HOSTS=["taxflow.ai","api.taxflow.ai","app.taxflow.ai"]

# ---------- SECURITY ----------
SECRET_KEY= # openssl rand -hex 32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_HASH_ALGORITHM=argon2id
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=19456
ARGON2_PARALLELISM=1
MFA_ISSUER_NAME=TaxFlow AI
ENCRYPTION_KEY= # 32‑byte base64 key for Fernet
MFA_RECOVERY_CODES_COUNT=8
MAX_LOGIN_ATTEMPTS=5
LOGIN_ATTEMPT_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=true
SESSION_EXPIRE_DAYS=30
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_DOMAIN=.taxflow.ai
CSP_DIRECTIVES="default-src 'self'; script-src 'self' 'unsafe-inline' https://js.stripe.com https://cdn.mxpnl.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://api.stripe.com https://api.mixpanel.com;"
SECURITY_CONTACT=security@taxflow.ai

# ---------- RATE LIMITING ----------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_STRICT=5/minute
RATE_LIMIT_STORAGE_URI=redis://redis:6379/3

# ---------- DATABASE ----------
POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=strongpassword
POSTGRES_DB=taxflow
DATABASE_URL=postgresql+asyncpg://postgres:strongpassword@db:5432/taxflow
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600
DATABASE_ECHO=false
DATABASE_STATEMENT_TIMEOUT=30000
DATABASE_QUERY_TIMEOUT=30

# ---------- REDIS ----------
REDIS_URL=redis://:redispass@redis:6379/0
REDIS_PASSWORD=redispass
CELERY_BROKER_URL=redis://:redispass@redis:6379/1
CELERY_RESULT_BACKEND=redis://:redispass@redis:6379/2
REDIS_MAX_CONNECTIONS=50

# ---------- OPENAI ----------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-latest
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CATEGORIZATION_CACHE_TTL=604800
OPENAI_REQUEST_TIMEOUT=30
OPENAI_MAX_RETRIES=3
OPENAI_FALLBACK_MODEL=gpt-3.5-turbo

# ---------- STRIPE ----------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_API_VERSION=2025-02-24.acacia
STRIPE_PRICE_PRO=price_pro
STRIPE_PRICE_FIRM=price_firm
STRIPE_PRICE_PRO_YEARLY=price_pro_yearly
STRIPE_PRICE_FIRM_YEARLY=price_firm_yearly
STRIPE_CONNECT_CLIENT_ID=ca_...
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_connect...
STRIPE_TAX_ENABLED=true
STRIPE_TAX_CODE=taxcode
STRIPE_WEBHOOK_TOLERANCE=300

# ---------- AWS ----------
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
AWS_S3_BUCKET=taxflow-receipts-prod
AWS_S3_EXPORT_BUCKET=taxflow-exports
AWS_S3_ENDPOINT_URL=
AWS_CLOUDFRONT_DOMAIN=https://d123.cloudfront.net
AWS_S3_MAX_CONNECTIONS=25

# ---------- AFFILIATE ----------
AFFILIATE_COMMISSION_RATE=0.20
AFFILIATE_MIN_WITHDRAWAL=1000   # cents
AFFILIATE_COOKIE_DAYS=30
FRONTEND_URL=https://app.taxflow.ai
AFFILIATE_PAYOUT_METHODS=["stripe_connect","paypal","bank_transfer"]
AFFILIATE_AUTO_PAYOUT_THRESHOLD=5000
AFFILIATE_AUTO_PAYOUT_CRON="0 9 * * 1"  # Every Monday at 9am

# ---------- FILE UPLOAD ----------
MAX_UPLOAD_SIZE=52428800
ALLOWED_EXTENSIONS=csv,xlsx,pdf,jpg,png,jpeg,tiff
OCR_PROCESSOR=textract
OCR_MAX_RETRIES=3
OCR_CONCURRENT_TASKS=5

# ---------- TRACING ----------
OTEL_SERVICE_NAME=taxflow-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=prometheus

# ---------- FEATURE FLAGS ----------
ENABLE_AI_CATEGORIZATION=true
ENABLE_AUDIT_LOG=true
ENABLE_PGVECTOR_SEARCH=true
ENABLE_TEAMS=true
ENABLE_CLIENT_PORTAL=true
ENABLE_QUICKBOOKS_INTEGRATION=true
ENABLE_AFFILIATE_AUTO_PAYOUT=true

# ---------- EMAIL ----------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG....
EMAIL_FROM=noreply@taxflow.ai
EMAIL_VERIFICATION_REQUIRED=true
EMAIL_TEMPLATE_DIR=app/infrastructure/email/templates
EMAIL_BATCH_SIZE=50
EMAIL_RATE_LIMIT=100/minute
EMAIL_BOUNCE_WEBHOOK_SECRET=whsec_email...
EMAIL_BOUNCE_WEBHOOK_URL=https://api.taxflow.ai/api/v1/webhooks/email-bounce
EMAIL_DKIM_SELECTOR=mailo
EMAIL_DKIM_DOMAIN=taxflow.ai
EMAIL_DKIM_PRIVATE_KEY_PATH=/run/secrets/dkim_private

# ---------- SENTRY ----------
SENTRY_DSN=https://...
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.2

# ---------- COOKIE CONSENT ----------
COOKIE_CONSENT_ENABLED=true
COOKIE_CONSENT_BANNER_MESSAGE="We use cookies to enhance your experience."
COOKIE_CONSENT_PRIVACY_POLICY_URL=/privacy
COOKIE_CONSENT_TERMS_URL=/terms

# ---------- BACKUP ----------
BACKUP_ENABLED=true
BACKUP_S3_BUCKET=taxflow-backups
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30

# ---------- INTEGRATIONS ----------
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=https://api.taxflow.ai/api/v1/integrations/quickbooks/callback
QUICKBOOKS_ENVIRONMENT=sandbox

# ---------- WEBHOOKS ----------
WEBHOOK_IDEMPOTENCY_CACHE_TTL=86400
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_BACKOFF_FACTOR=2
WEBHOOK_RETRY_MAX_DELAY=3600  # 1 hour

# ---------- ANALYTICS ----------
MIXPANEL_TOKEN=
MIXPANEL_API_HOST=https://api.mixpanel.com

# ---------- SEARCH ----------
SEARCH_ENGINE=postgresql  # or elasticsearch
ELASTICSEARCH_HOST=elasticsearch:9200

# ---------- CELERY ----------
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=3000
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_MAX_TASKS_PER_CHILD=1000

# ---------- NEW RELIC ----------
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=TaxFlow API

# ---------- DATADOG ----------
DD_API_KEY=
DD_SITE=datadoghq.com
